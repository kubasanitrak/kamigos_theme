{
    "name": "acf/section-banners",
    "title": "Kamigos Section Banners (ACF Block)",
    "description": "Image cards that scroll to a section on this page. Place beside the existing title and intro.",
    "category": "formatting",
    "icon": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 36'><path d='M4 2h28a2 2 0 0 1 2 2v12H2V4a2 2 0 0 1 2-2zm2 4v6h24V6H6zm22 1.2 2.4 2.4-2.4 2.4-1.2-1.2 1.2-1.2-1.2-1.2zM4 20h28a2 2 0 0 1 2 2v12H2V22a2 2 0 0 1 2-2zm2 4v6h24v-6H6zm22 1.2 2.4 2.4-2.4 2.4-1.2-1.2 1.2-1.2-1.2-1.2z'/></svg>",
    "keywords": ["banner", "sekce", "tréninky", "scroll"],
    "acf": {
        "mode": "edit",
        "renderTemplate": "template.php",
        "fields": [
            {
                "key": "field_section_banners_banner_items",
                "name": "banner_items",
                "label": "Bannery",
                "type": "repeater",
                "layout": "block",
                "button_label": "Přidat banner",
                "sub_fields": [
                    {
                        "key": "field_section_banners_banner_label",
                        "name": "banner_label",
                        "label": "Nadpis",
                        "type": "text"
                    },
                    {
                        "key": "field_section_banners_banner_image",
                        "name": "banner_image",
                        "label": "Obrázek",
                        "type": "image",
                        "return_format": "id",
                        "preview_size": "medium",
                        "library": "all",
                        "mime_types": "jpg, jpeg, png, webp"
                    },
                    {
                        "key": "field_section_banners_banner_section_anchor",
                        "name": "banner_section_anchor",
                        "label": "Kotva sekce",
                        "instructions": "ID cílové sekce, bez #. Stejná hodnota jako HTML kotva v panelu Pokročilé.",
                        "type": "text",
                        "placeholder": "deti"
                    }
                ]
            }
        ]
    },
    "supports": {
        "align": false,
        "html": false,
        "jsx": false
    }
}
